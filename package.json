{
  "name": "delivery-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/dev.ts",
    "worker": "tsx --env-file-if-exists=.env server/worker-main.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.ts",
    "vercel-build": "npm run db:migrate && npm run build"
  },
  "dependencies": {
    "bullmq": "^5.61.0",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
